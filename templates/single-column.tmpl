%-------------------------
% Custom commands
\newcommand{\resumeExperienceMinimumSpace}{10\baselineskip}
\newcommand{\resumeRoleMinimumSpace}{5\baselineskip}

% \unskip drops trailing spaces from the item text. Without it, a bullet that
% fills the line exactly wraps a stray space after \vspace onto a blank line.
\newcommand{\resumeItem}[1]{%
    \item\small{%
        {#1\unskip\vspace{-2pt}}%
    }%
}
% Just in case someone needs a heading that does not need to be in a list
\newcommand{\resumeHeading}[3]{
    \begin{tabular*}{0.99\textwidth}[t]{l@{\extracolsep{\fill}}r}
        \textbf{#1} \\
        \textit{\small#2} & \textit{\small #3} \\
    \end{tabular*}\vspace{-5pt}
}

\ExplSyntaxOn
% Define storage variables
\tl_new:N \l_resume_company_tl
\tl_new:N \l_resume_location_tl
\tl_new:N \l_resume_dates_tl
\tl_new:N \l_resume_overview_tl

% Define the keys
\keys_define:nn { resume / experience }
    {
        company     .tl_set:N = \l_resume_company_tl,
        location    .tl_set:N = \l_resume_location_tl,
        dates       .tl_set:N = \l_resume_dates_tl,
        overview    .tl_set:N = \l_resume_overview_tl,
    }

% The actual macro
\NewDocumentCommand{\resumeExperienceHeading}{ O{} }
    {
        \Needspace{\resumeExperienceMinimumSpace}%
        \group_begin:
        % Clear variables each time
        \tl_clear:N \l_resume_company_tl
        \tl_clear:N \l_resume_location_tl
        \tl_clear:N \l_resume_dates_tl
        \tl_clear:N \l_resume_overview_tl

        % Parse key=values
        \keys_set:nn { resume / experience } { #1 }

        % Render
        \vspace{-1pt}\item
        \begin{tabular*}{0.97\textwidth}[t]{@{}l@{\extracolsep{\fill}}r@{}}%
            % Company + optional location
            \textcolor{accentColor}{\textbf{\large \tl_use:N \l_resume_company_tl}}%
            \tl_if_blank:VTF \l_resume_location_tl
                { } % nothing if empty
                { \textcolor{mutedColor}{\footnotesize\enspace\textbar\enspace \tl_use:N \l_resume_location_tl} }%
            &
            % Optional dates
            \tl_if_blank:VTF \l_resume_dates_tl
                { }
                { \textcolor{mutedColor}{\footnotesize \tl_use:N \l_resume_dates_tl} }%
            \\[-1pt]
            % Overview (spans both columns)
            \tl_if_blank:VTF \l_resume_overview_tl
                { }
                { \multicolumn{2}{@{}l@{}}{\parbox{\dimexpr0.97\textwidth\relax}{\raggedright\hyphenpenalty=10000\exhyphenpenalty=10000\footnotesize\textcolor{mutedColor}{\tl_use:N \l_resume_overview_tl}}}\\[3pt] }
        \end{tabular*}\vspace{1pt}%
        \group_end:
    }
\ExplSyntaxOff

\newcommand{\resumeSubheadingLocation}[3]{
    \vspace{3pt}\item
    \begin{tabular*}{0.97\textwidth}[t]{l@{\extracolsep{\fill}}r}
        \textbf{#1} & #2 \\
        \textit{\small#3} \\
    \end{tabular*}\vspace{-5pt}
}

\newcommand{\resumeSubheading}[3]{
    \vspace{-1pt}\item
    \begin{tabular*}{0.97\textwidth}[t]{@{}l@{\extracolsep{\fill}}r@{}}
        \textcolor{accentColor}{\textbf{\large#1}} \\
        \textit{\small#2} & \textit{\small #3} \\
    \end{tabular*}\vspace{-5pt}
}

\newcommand{\resumeSubSubheading}[2]{
    \Needspace{\resumeRoleMinimumSpace}%
    \begin{tabular*}{0.97\textwidth}{l@{\extracolsep{\fill}}r}
        \textbf{\textit{\small#1}} & \textit{\small #2} \\
    \end{tabular*}\vspace{-5pt}
}

\newcommand{\resumeProjectHeading}[2]{
    \item
    \begin{tabular*}{0.97\textwidth}{l@{\extracolsep{\fill}}r}
        \small#1 & #2 \\
    \end{tabular*}\vspace{-7pt}
}

\newcommand{\resumeSubItem}[2]{\resumeItem{#1}{#2}\vspace{-4pt}}

% \renewcommand{\labelitemii}{$\circ$}
\renewcommand{\labelitemii}{$\vcenter{\hbox{\tiny$\bullet$}}$}
\newcommand{\resumeSubHeadingListStart}{\begin{itemize}[leftmargin=*, label={}]}
\newcommand{\resumeSubHeadingListEnd}{\end{itemize}}
\newcommand{\resumeItemListStart}{\begin{itemize}\vspace{4pt}}
\newcommand{\resumeItemListEnd}{\end{itemize}\vspace{6pt}} %vspace{-5pt}

%-------------------------------------------
%%%%%%  CV STARTS HERE  %%%%%%%%%%%%%%%%%%%%%%%%%%%%


\begin{document}
\thispagestyle{empty}

%----------HEADING-----------------
\begin{center}
{\headingfont\textcolor{accentColor}{\textbf{\Huge \scshape {{$details.Name}}}}} \\ \vspace{1pt}
\small \href{tel:{{$details.Contact.Phone}}}{ {{- $details.Contact.Phone}}} $|$ \href{mailto:{{$details.Contact.Email}}}{ {{- $details.Contact.Email}}} $|$
\href{https://www.{{$details.Contact.LinkedIn}}}{LinkedIn} $|$
\href{https://www.{{$details.Contact.GitHub}}}{GitHub}
\end{center}

{{- if not .Config.Summary.Hide}}
%-----------OVERVIEW-----------------
\section{Overview}
\small {{latexEscape $details.Summary}}
{{ end -}}

{{- $visibleExperience := visibleExperience $details.Experience -}}
{{- if and (not .Config.Experience.Hide) (ne (len $visibleExperience) 0) }}
%-----------EXPERIENCE-----------------
\section{Experience}
\resumeSubHeadingListStart
{{ range $experience := $visibleExperience -}}
    \resumeExperienceHeading[
    company={ {{- $experience.Company}}},
    {{ if and (not $.Config.Experience.HideLocation) (ne $experience.Location "") -}}
        location={ {{- $experience.Location}}},
    {{ end -}}
    {{ if and (not $.Config.Experience.HideDate) (ne $experience.StartDate "") -}}
        dates={ {{- $experience.StartDate}} — {{- $experience.EndDate}}},
    {{ end -}}
    {{ if and (not $.Config.Experience.HideOverview) (ne $experience.Overview "") -}}
        overview={ {{- latexEscape $experience.Overview}}},
    {{ end -}}
    ]
    {{ range $index, $position := $experience.Positions -}}
        \resumeSubSubheading
            { {{- $position.Title}}}{ {{- $position.StartDate}} — {{- $position.EndDate}}}
            \resumeItemListStart
            {{- range $position.Responsibilities }}
                \resumeItem{ {{- latexEscape .}} }
            {{- end }}
            \resumeItemListEnd
    {{ end -}}
    {{ if and (not $.Config.Experience.HideTechnologies) (ne (len $experience.Technologies) 0) -}}
    \begin{tabular*}{0.97\textwidth}{l@{}r}
        \vspace{12pt}
        \textcolor{mutedColor}{\textit{\footnotesize{Technologies: }}} & \textcolor{mutedColor}{\textit{\footnotesize{ {{- join $experience.Technologies ", "}}}}}\\
    \end{tabular*}\vspace{-5pt}
    {{ end -}}
{{ end -}}
\resumeSubHeadingListEnd
{{ end -}}

{{- $visibleProjects := visibleProjects $details.Projects -}}
{{- if and (not .Config.Projects.Hide) (ne (len $visibleProjects) 0) }}
%-----------PROJECTS-----------
\section{Projects}
\resumeSubHeadingListStart
{{ range $visibleProjects -}}
    \resumeProjectHeading
    {\textbf{ {{- .Name}}} $|$ \emph{ {{- join .Technology ", "}}}}{
    {{- if .Website }} \href{ {{- .Website}}}{\underline{Website}}{{ end -}}
    {{- if and .Website .Github }} $|${{ end -}}
    {{- if .Github }} \href{ {{- .Github}}}{\underline{GitHub}}{{ end -}}
    }
    %\small{ { {{- .Description}} \vspace{2pt}}}
    \resumeItemListStart
        {{- range .Items }}
            \resumeItem{ {{- latexEscape .}} }
        {{- end }}
    \resumeItemListEnd
{{ end -}}
\resumeSubHeadingListEnd
{{ end -}}

%--------SKILLS------------
\section{Technical Skills}
\begin{itemize}[leftmargin=0.15in, label={}]
\small{\item{
\begin{tabularx}{\linewidth}{@{}>{\bfseries}l@{\hspace{0.75em}}>{\raggedleft\arraybackslash}X@{}}
{{- range $cat := (orderedSkills $details.Skills) }}
    {{- $cat.Name}}: & {{ range $i, $v := $cat.Values }}{{if $i}}, {{end}}{{$v}}{{end}} \\[4pt]
{{- end }}
\end{tabularx}
}}
\end{itemize}

{{- $visibleEducation := visibleEducation $details.Education -}}
{{- if and (not .Config.Education.Hide) (ne (len $visibleEducation) 0) }}
%-----------EDUCATION-----------------
\section{Education}
\resumeSubHeadingListStart
{{- range $visibleEducation}}
    \resumeSubheadingLocation
    { {{- .Institution}}{{if ne .College ""}}, {{.College}}{{end}}}{ {{- .StartDate}} — {{.EndDate}}}
    { {{- .Degree}}{{if ne .GPA ""}}; GPA: {{.GPA}}{{end}}}
{{ end -}}
\resumeSubHeadingListEnd
{{ end -}}

%-------------------------------------------
\end{document}
